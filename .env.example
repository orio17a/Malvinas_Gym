# Copiar este archivo como .env y completar los valores reales.
# Nunca commitear el .env real.

DJANGO_SECRET_KEY=cambiar-por-una-clave-secreta-generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Postgres. Si se deja DB_NAME vacío, el proyecto cae a sqlite (solo
# para probar rápido en desarrollo).
DB_NAME=malvinas_gym
DB_USER=malvinas_gym
DB_PASSWORD=cambiar
DB_HOST=localhost
DB_PORT=5432

# Backend de email. En dev dejar el de consola; en producción usar smtp.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# --- Solo relevantes cuando DJANGO_DEBUG=False (producción) ---
# Dominios reales del panel que pueden enviar POST con CSRF (con esquema,
# ej: https://gestion.malvinasgym.com). Separados por coma.
DJANGO_CSRF_TRUSTED_ORIGINS=
# Poner en False solo si HTTPS ya lo termina un proxy/balanceador antes
# de llegar a Django (para evitar un redirect loop).
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
